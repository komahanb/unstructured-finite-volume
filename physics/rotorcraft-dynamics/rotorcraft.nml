! THE SETUP of rotorcraft_dynamics
&setup
  blade       = 'rigid'        ! rigid or beam; plate and solid to come
  scenario    = 'collective'   ! collective, longitudinal or lateral
  thickness   = 0.02           ! of the blades
  revolutions = 1
  steps       = 360            ! per revolution
  span_points = 9              ! of a blade as a beam
  section_kind = 'solid'       ! of a blade as a beam: solid, the plate; given, its properties (README.md)
/
