{
  "title": "Architect-worker Claude report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "task_id",
    "status",
    "summary",
    "base_head",
    "changed_files",
    "requirements",
    "checks",
    "naming_audit",
    "assumptions",
    "risks",
    "questions",
    "proposed_next_steps"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "architect-worker-v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["satisfied", "partial", "blocked", "not_started"]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status", "exit_code", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not_run", "interrupted"]
          },
          "exit_code": {"type": ["integer", "null"]},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "naming_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "surface", "findings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["canonical", "issues", "not_applicable"]
        },
        "surface": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identifier", "verdict", "reason"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1},
              "verdict": {
                "type": "string",
                "enum": ["canonical", "rename", "legacy_boundary", "taxonomy_review"]
              },
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "proposed_next_steps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
