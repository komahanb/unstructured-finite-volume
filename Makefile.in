#=====================================================================#
# User Options
#=====================================================================#

# general
COMPILER = gnu
F2008    = yes
COMPLEX  = no

# optimization level
DEBUG    = no
PROFILE  = no
OPTIMIZE = yes

# OpenMP: compiles the !$omp directives and !$ sentinel lines and links
# libgomp. Read from the environment so that every suite Makefile that
# includes this file compiles against the library with the same flag.
OPENMP  ?= no

# Floating-point trap of the debug build (invalid, overflow, underflow);
# FPETRAP=no omits it for concurrent runs.
FPETRAP ?= yes

# libraries
LAPACK   = no
MPI      = no
HDF5     = no
PETSC    = no
TECIO    = no

#=====================================================================#
# External Library Paths
#=====================================================================#

MPI_DIR    = $(HOME)/install/mpich-3.2/builild
HDF5_DIR   = /opt/hdf5/1.8.9-$(COMPILER)
PETSC_DIR  = $(HOME)/install/petsc/3.7.4
LAPACK_DIR = /usr
TECIO_DIR  = $(HOME)/install/tecplot360ex

#=====================================================================#
# Add git SHA-1 hash
#=====================================================================#

# GIT_SHA1 = $(shell git log -1 | head -n 1 | awk '{print $$2}')

#=====================================================================#
# GNU Fortran compiler options
#=====================================================================#

ifeq ($(COMPILER),gnu)
  # gfortran-14 builds both variants, one image and several (override
  # with `make F90=...`): the packaged OpenCoarrays 2.9.2 over OpenMPI
  # defines the coarray interface of GCC 14, not that of GCC 15, which
  # needs a runtime built from source. Other versions only when 14 is
  # absent; gfortran-16 (trunk snapshot 20260315) last, since it
  # miscompiled the retired legacy mesh.
  F90 := $(shell for c in gfortran-14 gfortran-13 gfortran-12 gfortran gfortran-11 gfortran-10 gfortran-9 gfortran-8 gfortran-7 gfortran-15 gfortran-16; do command -v $$c >/dev/null 2>&1 && { echo $$c; exit; }; done; echo gfortran)
  F90FLAGS := -fcoarray=single -cpp -fPIC -Wno-line-truncation

  # the newest standard the selected compiler supports (f2023 requires gcc 13+)
  FSTD := $(shell $(F90) -std=f2023 -fsyntax-only -x f95 /dev/null >/dev/null 2>&1 && echo f2023 || echo f2018)

  # COMPLEX mode
  ifeq ($(COMPLEX),yes)
    F90FLAGS += -DUSE_COMPLEX
  endif

  # Working precision: real64 unless PRECISION=quad, which selects
  # real128 and installs a separate library so the two builds coexist.
  LIBDIR := ../lib
  ifeq ($(PRECISION),quad)
    F90FLAGS += -DPRECISION_QUAD
    LIBDIR := ../lib_quad
  endif

  # Coarray images: COARRAY=lib compiles every source with
  # -fcoarray=lib, by the same compiler as the one-image build, against
  # the packaged OpenCoarrays (libcaf_openmpi over OpenMPI, run by
  # mpirun -np N; one image needs OMPI_MCA_osc=pt2pt) and installs into
  # lib_par/. The default -fcoarray=single build treats every image
  # statement as one image.
  ifeq ($(COARRAY),lib)
    F90FLAGS := $(subst -fcoarray=single,-fcoarray=lib,$(F90FLAGS))
    LIBDIR   := ../lib_par
    # OPENCOARRAYS, when set, is the prefix of an OpenCoarrays built
    # from source (lib/libcaf_mpi.a), compiled and linked through the
    # MPI wrapper of the MPI it was built against; otherwise the
    # packaged runtime over the packaged OpenMPI
    ifneq ($(OPENCOARRAYS),)
      F90      := mpifort
      CAF_LIBS := $(OPENCOARRAYS)/lib/libcaf_mpi.a
    else
      CAF_LIBS := /usr/lib/x86_64-linux-gnu/open-coarrays/openmpi/lib/libcaf_openmpi.a \
                  -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi_mpifh -lmpi -lopen-rte -lopen-pal \
                  -lhwloc -levent_core -levent_pthreads -lm -lz
    endif
    LDFLAGS  += $(CAF_LIBS)
  endif

  # Fortran standard: the newest the compiler supports, detected above
  ifeq ($(F2008),no)
    F90FLAGS += -DNO_F2008
  else
    F90FLAGS += -std=$(FSTD)
  endif

  # Debugging. FPETRAP=no omits the floating-point trap: the trap mask is
  # inherited by every thread, so a non-finite value in one concurrent
  # execution terminates the process, whereas the solvers return
  # SOLVE_NONFINITE without it.
  ifeq ($(DEBUG),yes)
    F90FLAGS += -g -Wall -pedantic -fbounds-check -fbacktrace
    ifeq ($(FPETRAP),yes)
      F90FLAGS += -ffpe-trap=invalid,overflow,underflow
    endif
    LDFLAGS  += -g
  endif

  # Profiling
  ifeq ($(PROFILE),yes)
    F90FLAGS += -pg
    LDFLAGS  += -pg
  endif

  # Optimization
  ifeq ($(OPTIMIZE),yes)
    F90FLAGS += -O3
  endif

  # OpenMP: -fopenmp implies -frecursive and -pthread
  ifeq ($(OPENMP),yes)
    F90FLAGS += -fopenmp
    LDFLAGS  += -fopenmp
  endif
endif

#=====================================================================#
# Intel Fortran compiler options
#=====================================================================#

ifeq ($(COMPILER),intel)
  F90 = ifort
  F90FLAGS := -cpp -warn -assume byterecl -traceback
  LDFLAGS =

  # Debugging
  ifeq ($(DEBUG),yes)
    F90FLAGS += -g -ftrapuv -fp-stack-check -check all -fpe0
    LDFLAGS  += -g
  endif

  # Profiling
  ifeq ($(PROFILE),yes)
    F90FLAGS += -pg
    LDFLAGS  += -pg
  endif

  # Optimization
  ifeq ($(OPTIMIZE),yes)
    F90FLAGS += -O3
  endif
endif

#=====================================================================#
# Setup External Libraries
#=====================================================================#

# LAPACK for linear algebra
ifeq ($(LAPACK),yes)
  F90FLAGS += -I$(LAPACK_DIR)/include
  LDFLAGS  += -L$(LAPACK_DIR)/lib -llapack
endif

# TECIO for post processing
ifeq ($(TECIO),yes)
  F90FLAGS += -I$(TECIO_DIR)/include
  LDFLAGS  += -L$(TECIO_DIR)/bin -ltecio -lstdc++ # tecplot libraries are in bin folder
endif

# MPI for distributed-memory parallelism
ifeq ($(MPI),yes)
  F90 = mpif90
  F90FLAGS += -DMPI
endif

# HDF5 for I/O
ifeq ($(HDF5),yes)
  F90FLAGS += -DHDF5 -I$(HDF5_DIR)/include
  LDFLAGS += -L$(HDF5_DIR)/lib $(HDF5_DIR)/lib/libhdf5hl_fortran.a \
             $(HDF5_DIR)/lib/libhdf5_hl.a $(HDF5_DIR)/lib/libhdf5_fortran.a \
             $(HDF5_DIR)/lib/libhdf5.a -lz -lrt -lm -Wl,-rpath -Wl,$(HDF5_DIR)/lib
endif

# PETSC
ifeq ($(PETSC),yes)
  # Check to make sure MPI is set
  ifneq ($(MPI),yes)
    $(error MPI must be enabled to compile with PETSC!)
  endif

  # Set up PETSc environment
  F90FLAGS += -I${PETSC_DIR}/linux-gnu-c-opt/include -DPETSC
  LDFLAGS +=  -lpetsc
endif

#=====================================================================#
# Machine-specific setup
#=====================================================================#

# IBM Blue Gene/P ANL supercomputer

ifeq ($(MACHINE),bluegene)
  F90 = /bgsys/drivers/ppcfloor/comm/xl/bin/mpixlf2003
  F90FLAGS = -WF,-DNO_F2008,-DMPI -O3
endif

# Cray XK6 ORNL Titan supercomputer

ifeq ($(MACHINE),crayxk6)
  F90 = ftn
  F90FLAGS += -DMPI
endif
