#!/bin/bash
# Reject a commit that breaks the naming rules (doc/coding-standards.md).
#
# The check runs on the STAGED tree - what this commit will actually
# contain - not the working tree, so an unstaged fix cannot make a
# broken commit pass and an unstaged breakage cannot block a
# valid one.
#
# Install once per clone:
#
#     git config core.hooksPath githooks
#
# The same checks run in test/graph-ordinary/run.sh; check_naming.sh
# is the one implementation both call.
set -e

root="$(git rev-parse --show-toplevel)"

staged_tree=$(mktemp -d)
trap 'rm -rf "$staged_tree"' EXIT

git checkout-index --prefix="$staged_tree/" -a

# The staged checker and scanner must both be present in the commit.
naming_check="$staged_tree/check_naming.sh"
if [ ! -f "$naming_check" ] || [ ! -f "$staged_tree/tools/check_vocabulary.py" ]; then
    echo " the commit is rejected: the staged naming checks are incomplete"
    exit 1
fi

bash "$naming_check" "$staged_tree" || {
    echo ""
    echo " the commit is rejected: the staged tree breaks the naming rules"
    echo " (doc/coding-standards.md); fix and stage the fix."
    exit 1
}
