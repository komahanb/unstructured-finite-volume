#=====================================================================#
# What the library is made of, in the order it must compile.
#
# The four roots say what anything can be. Everything after them is
# a concretion of one of the four, listed so that a file appears
# after everything it uses.
#=====================================================================#

roots = \
  structure/graph.o \
  data/graph_field.o \
  operation/graph_operation.o \
  transform/graph_transform.o

# Graphs, values, operations and transforms that stand on the roots.
parts = \
  structure/support.o \
  data/field.o \
  data/functional.o \
  structure/stored_graph.o \
  structure/mesh.o \
  model/robin_condition.o \
  model/conduction.o \
  model/advection.o \
  operation/stencil.o \
  operation/step.o \
  operation/difference_linearization.o \
  structure/graph_form.o \
  structure/polynomial_form.o \
  structure/harmonic_form.o \
  operation/reduction.o \
  operation/walk.o \
  transform/partitioner.o \
  transform/assembler.o \
  transform/coarsener.o \
  transform/refiner.o \
  operation/differential.o \
  operation/balance.o \
  operation/fit_optimizer.o \
  operation/fitted_balance.o \
  model/diffusion_statement.o

# Scheduled for deletion when the native mesh reader lands.
legacy = \
  legacy/solve_mode.o \
  legacy/verbosity.o \
  legacy/string.o \
  legacy/file.o \
  legacy/interface_graph.o \
  legacy/old_stored_graph.o \
  legacy/mesh_utils.o \
  legacy/mesh_loader.o \
  legacy/array_mesh_loader.o \
  legacy/gmsh_loader.o \
  legacy/old_mesh.o \
  legacy/mesh_builder.o

objects = $(roots) $(parts) $(legacy)
